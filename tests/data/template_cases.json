       "ratio": {
        "type": "number",
        "default": 0.1,
        "minimum": 1e-05,
        "maximum": 1e+16
       },
       "weight": {
        "type": "number",
        "default": 2.0
       },
       "flags": {
        "type": "object",
        "additionalProperties": {
         "type": "boolean"
        },
        "default": {
         "a": true,
         "b": false
        }
       },
       "meta": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
         "^x-": {
          "type": "string"
         }
        }
       },
       "tags": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "default": [],
        "maxItems": 10
       },
       "note": {
        "type": "string",
        "default": ""
       },
       "big": {
        "type": "integer",
        "default": 12345678901234
       }
      },
      "required": [
       "title",
       "attendees"
      ]
     },
     "returns": {
      "type": "object",
      "properties": {
