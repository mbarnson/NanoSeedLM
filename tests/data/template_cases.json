      "properties": {
       "title": {
        "type": "string",
        "title": "Title",
        "examples": [
         "Standup",
         "1:1"
        ]
       },
       "attendees": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/Person"
        },
        "description": "Who comes.\nAt least one."
