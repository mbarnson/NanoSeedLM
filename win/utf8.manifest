<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- win/utf8.manifest - embedded in every executable (CMakeLists.txt): the process code page is UTF-8 (Windows 10 1903
     and later), so the UTF-8 paths of plat_init's argv work with fopen, CreateFileA and every other narrow API. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
